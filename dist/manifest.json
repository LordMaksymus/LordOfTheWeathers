{
  "manifest_version": 3,
  "name": "WeatherEx",
  "version": "1.0.0",
  "description": "Local weather, hourly charts, and daily forecasts in a toolbar popup.",
  "icons": {
    "64": "icons/weathericon.png",
    "128": "icons/weathericon128.png"
  },
  "action": {
    "default_icon": {
      "64": "icons/weathericon.png"
    },
    "default_popup": "popup.html"
  },
  "permissions": ["storage", "geolocation"],
  "host_permissions": [
    "https://api.open-meteo.com/*",
    "https://nominatim.openstreetmap.org/*"
  ]
}
